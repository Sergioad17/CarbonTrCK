PORT=3001
NODE_ENV=development

DATABASE_URL=postgresql://carbontrack_app:change_this_password@localhost:5432/carbontrack
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
APP_BASE_URL=http://localhost:3001
BCRYPT_ROUNDS=10
FORGOT_PASSWORD_TOKEN_TTL=30m

# ── Motor de alertas / notificaciones ────────────────────────────────────────
# Resend.com (email). Genera la API key en https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=CarbonTrack <onboarding@resend.dev>
RESEND_REPLY_TO=

# Scheduler de alertas (cada N minutos). Soporta "*/N * * * *" o un entero N.
ALERTS_SCHEDULER_ENABLED=true
ALERTS_SCHEDULER_CRON=*/5 * * * *
ALERTS_DEDUPE_RETENTION_DAYS=30
ALERTS_WEBHOOK_TIMEOUT_MS=5000
# URL pública del frontend para incluir en correos/webhooks (links absolutos)
ALERTS_APP_URL=http://localhost:5173
