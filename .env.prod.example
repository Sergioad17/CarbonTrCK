# ─── Copia este archivo como .env.prod y completá los valores ────────────────
# NUNCA subas .env.prod al repositorio (ya está en .gitignore)

# ── Modo de acceso del sitio ─────────────────────────────────────────────────
# "private" → solo IPs en la whitelist de nginx/nginx.conf.template (default)
# "public"  → abierto al mundo
# Cambiar con: ./ct-mode.sh public  |  ./ct-mode.sh private
ACCESS_MODE=private

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
APP_BASE_URL=https://carbontrack.lat/api

# Cambiá estos secretos por strings largos y aleatorios
# Podés generar uno con: openssl rand -hex 64
JWT_ACCESS_SECRET=REEMPLAZAR_CON_SECRET_LARGO_Y_ALEATORIO
JWT_REFRESH_SECRET=REEMPLAZAR_CON_OTRO_SECRET_LARGO_Y_ALEATORIO
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

BCRYPT_ROUNDS=12
FORGOT_PASSWORD_TOKEN_TTL=30m

# ── Motor de alertas / notificaciones ────────────────────────────────────────
# Resend.com — usar un dominio verificado en producción
RESEND_API_KEY=REEMPLAZAR_API_KEY_DE_RESEND
RESEND_FROM_EMAIL=CarbonTrack <alertas@carbontrack.lat>
RESEND_REPLY_TO=soporte@carbontrack.lat

# Cadencia del scheduler ("*/N * * * *" o entero N en minutos)
ALERTS_SCHEDULER_ENABLED=true
ALERTS_SCHEDULER_CRON=*/5 * * * *
ALERTS_DEDUPE_RETENTION_DAYS=30
ALERTS_WEBHOOK_TIMEOUT_MS=5000
# URL pública del frontend para links absolutos en correos/webhooks
ALERTS_APP_URL=https://carbontrack.lat

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://carbontrack_app:REEMPLAZAR_PASSWORD@postgres:5432/carbontrack

POSTGRES_DB=carbontrack
POSTGRES_USER=carbontrack_app
POSTGRES_PASSWORD=REEMPLAZAR_PASSWORD
