# ─── Copia este archivo como .env.prod y completá los valores ────────────────
# NUNCA subas .env.prod al repositorio (ya está en .gitignore)

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
APP_BASE_URL=https://carbontrack.lat/api

# Cambiá estos secretos por strings largos y aleatorios
# Podés generar uno con: openssl rand -hex 64
JWT_ACCESS_SECRET=REEMPLAZAR_CON_SECRET_LARGO_Y_ALEATORIO
JWT_REFRESH_SECRET=REEMPLAZAR_CON_OTRO_SECRET_LARGO_Y_ALEATORIO
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

BCRYPT_ROUNDS=12
FORGOT_PASSWORD_TOKEN_TTL=30m

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://carbontrack_app:REEMPLAZAR_PASSWORD@postgres:5432/carbontrack

POSTGRES_DB=carbontrack
POSTGRES_USER=carbontrack_app
POSTGRES_PASSWORD=REEMPLAZAR_PASSWORD
